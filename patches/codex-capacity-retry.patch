 const codexIncompleteStreamMessage = "stream closed before response.completed"
 
+var codexCapacityPatterns = []*regexp.Regexp{
+	regexp.MustCompile(`(?i)selected\s+model\s+is\s+(?:currently\s+)?(?:unavailable\s+due\s+to\s+)?capacity`),
+	regexp.MustCompile(`(?i)model[\s_-]+(?:is[\s_-]+)?(?:at[\s_-]+)?capacity`),
+	regexp.MustCompile(`(?i)remote\s+compact\s+task.*capacity`),
