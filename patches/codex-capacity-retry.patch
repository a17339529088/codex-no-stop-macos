+
+var codexCapacityConfigOnce sync.Once
+var codexCapacityRetryEnabled = true
+
+func loadCodexCapacityRetryConfig() {
+	codexCapacityConfigOnce.Do(func() {
+		path := strings.TrimSpace(os.Getenv("COCKPIT_CAPACITY_RETRY_CONFIG"))
+		if path == "" {
+			if executable, err := os.Executable(); err == nil {
+				path = filepath.Join(filepath.Dir(executable), "codex-capacity-retry.json")
+				if _, err := os.Stat(path); err != nil {
+					path = filepath.Join(filepath.Dir(executable), "..", "codex-capacity-retry.json")
+				}
+			}
+		}
+		if path == "" {
+			return
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return
+		}
+		var config struct {
+			Enabled  *bool    `json:"enabled"`
+			Patterns []string `json:"patterns"`
+		}
+		if json.Unmarshal(data, &config) != nil {
+			return
+		}
+		if config.Enabled != nil {
+			codexCapacityRetryEnabled = *config.Enabled
+		}
+		compiled := make([]*regexp.Regexp, 0, len(config.Patterns))
+		for _, pattern := range config.Patterns {
+			if re, err := regexp.Compile(pattern); err == nil {
+				compiled = append(compiled, re)
+			}
+		}
+		if len(compiled) > 0 {
+			codexCapacityPatterns = compiled
+		}
+	})
+}
